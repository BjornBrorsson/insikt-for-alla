# Firebase-klientkonfiguration (publika värden, bäddas in i klientbundeln).
# Hämtas med: firebase apps:sdkconfig web <APP_ID> --project insikt-riksdag
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (servern): på Cloud Run används tjänstens servicekonto
# automatiskt. Lokalt: kör `gcloud auth application-default login`.
FIREBASE_PROJECT_ID=insikt-riksdag

# Server-hemligheter (ligger i Secret Manager i produktion).
GEMINI_API_KEY=
INGEST_SECRET=

# Behövs bara för migreringsskriptet scripts/migrera-till-firestore.mjs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
