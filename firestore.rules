rules_version = '2';

// Alla läsningar och skrivningar går via servern (Firebase Admin SDK,
// som kringgår reglerna). Klienten når aldrig databasen direkt –
// publik data serveras via serverfunktionerna och admin via Firebase
// ID-token + anvandarroller/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
